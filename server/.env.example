# ============================================================
# Copiez ce fichier en ".env" (sans le ".example") et remplissez
# vos vraies valeurs. Le fichier ".env" ne doit JAMAIS être
# partagé ni envoyé sur GitHub (il est déjà ignoré, voir .gitignore).
# ============================================================

# --- MongoDB Atlas ---
# Chaîne de connexion trouvée dans Atlas > Database > Connect > Drivers
# Remplacez <db_password> par le vrai mot de passe et ajoutez le nom
# de la base à la fin, ex: .../binta-ice-cream?retryWrites=true...
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@CLUSTER.mongodb.net/binta-ice-cream?retryWrites=true&w=majority

# --- Identifiants admin (les seuls qui pourront se connecter à /admin.html) ---
ADMIN_EMAIL=admin@bintaicecream.com
ADMIN_PASSWORD=change-moi-en-un-mot-de-passe-solide

# --- Sécurité des sessions (JWT) ---
# Une longue chaîne aléatoire, ex: générée avec `openssl rand -hex 32`
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# --- Cloudinary (hébergement des photos produits) ---
# Trouvés sur le tableau de bord Cloudinary (cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=votre-cloud-name
CLOUDINARY_API_KEY=votre-api-key
CLOUDINARY_API_SECRET=votre-api-secret

# --- Divers ---
PORT=4000
